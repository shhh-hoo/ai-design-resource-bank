{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AIDRB Candidate Inbox record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "candidate_kind",
    "status",
    "discovered_by",
    "source",
    "captured_at",
    "rationale",
    "novelty_axes"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^candidate:[a-z0-9-]+$"
    },
    "candidate_kind": {
      "enum": ["example", "concept", "tool", "resource", "source_feed"]
    },
    "status": {
      "enum": ["discovered", "inspected", "promote", "rejected", "deferred", "promoted"]
    },
    "discovered_by": {
      "enum": ["manual", "scout", "import"]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["locator_type", "locator"],
      "properties": {
        "locator_type": {
          "enum": ["url", "file", "image", "video", "repository", "paper", "prompt", "other", "user-upload"]
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "creator": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "captured_at": {
      "type": "string",
      "format": "date"
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "novelty_axes": {
      "type": "array",
      "uniqueItems": true,
      "minItems": 1,
      "items": {
        "enum": [
          "new_concept",
          "stronger_example",
          "new_medium",
          "new_interaction",
          "new_implementation",
          "cross_media_transfer",
          "benchmark_gap"
        ]
      }
    },
    "signals": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "benchmark_query_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "notes": {
      "type": "string"
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "rationale", "reviewed_by", "reviewed_at"],
      "properties": {
        "outcome": {
          "enum": ["promote", "rejected", "deferred", "promoted"]
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "reviewed_by": {
          "type": "string",
          "minLength": 1
        },
        "reviewed_at": {
          "type": "string",
          "format": "date"
        },
        "canonical_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": ["promote", "rejected", "deferred", "promoted"]
          }
        },
        "required": ["status"]
      },
      "then": {
        "required": ["decision"]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "promoted"
          }
        },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "decision": {
            "required": ["canonical_ids"],
            "properties": {
              "canonical_ids": {
                "minItems": 1
              }
            }
          }
        }
      }
    }
  ]
}
